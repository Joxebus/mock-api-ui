# Base URL for the mock-api backend. Empty string means "use the Vite dev proxy"
# (see vite.config.ts), which forwards /config, /endpoint and /api/ to :8080 and avoids CORS.
VITE_API_BASE_URL=

# Backend URL shown to users, e.g. in "Copy curl" on the Try it page. Not used for
# the app's own requests. Unset => VITE_API_BASE_URL, else http://localhost:8080.
VITE_BACKEND_URL=http://localhost:8080
